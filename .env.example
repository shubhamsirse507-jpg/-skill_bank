# =============================================
# Skill Exchange Platform — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================

# Django Core
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL Database
DB_ENGINE=django.db.backends.mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=skill_exchange_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# Email (console backend for dev, SMTP for prod)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@skillexchange.com

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS — comma separated origins for mobile/frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Static/Media
STATIC_ROOT=staticfiles
MEDIA_ROOT=media
