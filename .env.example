# SkillBank Platform — Environment Configuration Template
SECRET_KEY=change-this-to-a-super-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=.onrender.com,.railway.app,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Self-Hosted WebRTC Server Integration (shared with webrtc-meet/server)
WEBRTC_SERVER_URL=http://localhost:4000
INTERNAL_CALLING_SECRET=change-this-to-a-shared-internal-secret

# Optional PostgreSQL Database (If not set, defaults to local SQLite db.sqlite3)
# DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Email / SMTP Configuration (Required for 2FA & Password Reset OTPs)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-gmail-app-password
DEFAULT_FROM_EMAIL=Skill Bank <your-email@gmail.com>
EMAIL_TIMEOUT=15

# Brevo HTTPS Email API (Recommended for Render / cloud hosts where SMTP ports are blocked)
BREVO_API_KEY=your-brevo-v3-api-key
BREVO_SENDER_EMAIL=your-verified-sender@gmail.com
BREVO_SENDER_NAME=Skill Bank

# Dev-only: set True alongside DEBUG=True to log OTPs to the server console only
OTP_DEV_LOG=False
